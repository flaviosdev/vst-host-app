# ============================================================
# Pastas de build geradas pelo CMake / Visual Studio
# ============================================================
build/
build-*/
build_*/
out/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
*.dir/

# ============================================================
# Visual Studio
# ============================================================
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.userosscache
*.sdf
*.opensdf
